{
  "rewrites" : [
    {
      "source": "/api/
      (.*)",
      "destination": "/server.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
},
    {
      "src": "server/src/server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/src/server.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/client/"
    }
  ]
}
